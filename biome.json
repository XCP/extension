{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "e2e/**/*.ts",
      "!src/core/qr-code/qrcodegen.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "a11y": {
        "noAutofocus": "error",
        "noLabelWithoutControl": "error",
        "noSvgWithoutTitle": "error",
        "useButtonType": "error",
        "useKeyWithClickEvents": "error",
        "useSemanticElements": "error"
      },
      "complexity": {
        "noUselessCatch": "error"
      },
      "correctness": {
        "noEmptyPattern": "error",
        "noSwitchDeclarations": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "warn",
        "useParseIntRadix": "error"
      },
      "style": {
        "useImportType": "error"
      },
      "suspicious": {
        "noExportsInTest": "error",
        "noGlobalIsNan": "error",
        "noImplicitAnyLet": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noSkippedTests": "error",
        "useArraySortCompare": "error",
        "useIterableCallbackReturn": "error"
      },
      "nursery": {
        "noInvalidFileInputAccept": "error",
        "noUnmodifiedLoopCondition": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/platform/**/*.ts", "src/services/**/*.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "error"
          }
        }
      }
    },
    {
      "includes": ["e2e/**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/contexts/**",
        "src/hooks/**",
        "src/components/**",
        "src/pages/**",
        "src/entrypoints/popup/**",
        "src/entrypoints/sidepanel/**",
        "src/entrypoints/content.ts",
        "src/entrypoints/injected.ts",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/platform/walletManager",
                      "@/platform/auth/**",
                      "@/platform/provider/**",
                      "@/platform/storage/requestStorage",
                      "@/platform/storage/sessionMetadataStorage",
                      "@/platform/storage/updateStorage",
                      "@/platform/storage/keyStorage"
                    ],
                    "message": "Background-only module. Extension pages and content scripts reach the background through a service client (services/*Client), never by importing its implementation. A pure helper they need belongs in core/."
                  },
                  {
                    "group": ["@/services/*Service", "@/services/signDelivery"],
                    "message": "Background service implementation. Import its client (services/*ServiceClient) instead: the implementation would run in this context, against its own copy of wallet state."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/contexts/settings-context.tsx", "src/contexts/wallet-context.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/platform/walletManager",
                      "@/platform/auth/**",
                      "@/platform/provider/**",
                      "@/platform/storage/requestStorage",
                      "@/platform/storage/sessionMetadataStorage",
                      "@/platform/storage/updateStorage"
                    ],
                    "message": "Background-only module. Extension pages and content scripts reach the background through a service client (services/*Client), never by importing its implementation. A pure helper they need belongs in core/."
                  },
                  {
                    "group": ["@/services/*Service", "@/services/signDelivery"],
                    "message": "Background service implementation. Import its client (services/*ServiceClient) instead: the implementation would run in this context, against its own copy of wallet state."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
